vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO dugan-dev/UniMemory
    REF 3dbe431a6c9a4bb5cf0aebd9e472baebfd96f925
    SHA512 d1a9822fcf12fa0bdd17e8de129cb4fba9f8a9135e35958e8adf57939311ceb2141127e4e1b96be05b881bc6510343630a215903774aabf5d52ce20ed60e1b73
)
vcpkg_check_features(OUT_FEATURE_OPTIONS FEATURE_OPTIONS FEATURES statistics UNIMEMORY_STATISTICS)
vcpkg_cmake_configure(
    SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS
        ${FEATURE_OPTIONS}
        -DUNIMEMORY_BACKEND=standard
        -DUNIMEMORY_AGGRESSIVE_INLINING=OFF
        -DUNIMEMORY_BUILD_TESTS=OFF
        -DUNIMEMORY_BUILD_EXAMPLES=OFF
        -DUNIMEMORY_BUILD_BENCHMARKS=OFF
        -DUNIMEMORY_BUILD_DIAGNOSTICS=OFF
        -DBUILD_TESTING=OFF
    MAYBE_UNUSED_VARIABLES BUILD_TESTING
)
vcpkg_cmake_install()
vcpkg_cmake_config_fixup(CONFIG_PATH lib/cmake/UniMemory)
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug" "${CURRENT_PACKAGES_DIR}/share/licenses" "${CURRENT_PACKAGES_DIR}/lib")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE")
file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")
