if(NOT DEFINED PROGRAM OR NOT DEFINED BACKEND)
    message(FATAL_ERROR "PROGRAM and BACKEND are required")
endif()

# Exercise parsing limits without executing large workloads. An invalid variant
# proves an allowed count reaches suite dispatch; option order must not matter.
function(expect_count_failure suite count expected reversed)
    if(reversed)
        set(arguments --iterations "${count}" --variant invalid-count-probe --suite "${suite}")
    else()
        set(arguments --suite "${suite}" --variant invalid-count-probe --iterations "${count}")
    endif()
    execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "1" OR NOT error MATCHES "diagnostic failure: ${expected}")
        message(FATAL_ERROR "Count limit/${suite}/${count}/${reversed} failed: ${result} ${output}${error}")
    endif()
endfunction()
foreach(reversed IN ITEMS OFF ON)
    foreach(suite IN ITEMS clock statistics backend)
        expect_count_failure("${suite}" 200000000 "suite iteration limit exceeded" "${reversed}")
        expect_count_failure("${suite}" 50000001 "suite iteration limit exceeded" "${reversed}")
    endforeach()
    foreach(suite IN ITEMS hotpath api)
        expect_count_failure("${suite}" 200000001 "invalid positive count" "${reversed}")
        expect_count_failure("${suite}" 200000000 "unknown ${suite}" "${reversed}")
    endforeach()
endforeach()
foreach(selector IN ITEMS none default)
    set(arguments --suite clock)
    if(selector STREQUAL "none")
        list(APPEND arguments --backend none)
    endif()
    execute_process(COMMAND "${PROGRAM}" ${arguments} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "0" OR NOT error STREQUAL "")
        message(FATAL_ERROR "Clock/${selector} failed: ${result} ${output}${error}")
    endif()
    string(REPLACE "\r\n" "\n" output "${output}")
    string(REGEX REPLACE "\n$" "" output "${output}")
    string(REPLACE "\n" ";" rows "${output}")
    list(LENGTH rows row_count)
    if(NOT row_count EQUAL 4)
        message(FATAL_ERROR "Expected CSV header and three clock quantiles: ${output}")
    endif()
    list(POP_FRONT rows header)
    if(NOT header STREQUAL "suite,backend,variant,bytes,threads,operations,seconds,value,unit,checksum")
        message(FATAL_ERROR "Unexpected clock CSV header: ${header}")
    endif()
    set(number "[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?")
    foreach(quantile IN ITEMS p50 p99 "p99[.]9")
        list(POP_FRONT rows row)
        if(NOT row MATCHES "^clock,none,${quantile},0,1,10000,${number},${number},ns/sample,0$")
            message(FATAL_ERROR "Unexpected clock quantile: ${row}")
        endif()
    endforeach()
endforeach()
if(BACKEND STREQUAL "standard")
    set(other_backend mimalloc)
else()
    set(other_backend standard)
endif()
execute_process(COMMAND "${PROGRAM}" --suite hotpath --backend "${other_backend}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "1" OR NOT error MATCHES "diagnostic failure: benchmark requires the compiled backend")
    message(FATAL_ERROR "Mismatched allocator backend was not rejected: ${result} ${output}${error}")
endif()
