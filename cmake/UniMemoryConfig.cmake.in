@PACKAGE_INIT@
# Installed values must agree across every source/installed consumer TU.
set(UniMemory_BACKEND "@UNIMEMORY_BACKEND@")
set(UniMemory_STATISTICS "@UNIMEMORY_STATISTICS@")
if(DEFINED UNIMEMORY_BACKEND AND NOT UNIMEMORY_BACKEND STREQUAL UniMemory_BACKEND)
    set(UniMemory_FOUND FALSE)
    set(UniMemory_NOT_FOUND_MESSAGE "Installed UniMemory backend differs from the requested consumer profile")
    return()
endif()
if(DEFINED UNIMEMORY_STATISTICS AND NOT UNIMEMORY_STATISTICS STREQUAL UniMemory_STATISTICS)
    set(UniMemory_FOUND FALSE)
    set(UniMemory_NOT_FOUND_MESSAGE "Installed UniMemory statistics differ from the requested consumer profile")
    return()
endif()
set(UniMemory_CHECKS_POLICY "@UNIMEMORY_CHECKS@")
if(DEFINED UNIMEMORY_CHECKS AND NOT UNIMEMORY_CHECKS STREQUAL UniMemory_CHECKS_POLICY)
    set(UniMemory_FOUND FALSE)
    set(UniMemory_NOT_FOUND_MESSAGE "Installed UniMemory CHECKS policy differs from the requested consumer policy")
    return()
endif()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@UNIMEMORY_WITH_MIMALLOC@)
    find_dependency(mimalloc CONFIG)
endif()
if(@UNIMEMORY_WITH_JEMALLOC@)
    include("${CMAKE_CURRENT_LIST_DIR}/UniMemoryJemalloc.cmake")
    if(NOT UNIMEMORY_JEMALLOC_FOUND)
        set(UniMemory_FOUND FALSE)
        set(UniMemory_NOT_FOUND_MESSAGE "${UNIMEMORY_JEMALLOC_NOT_FOUND_MESSAGE}")
        return()
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/UniMemoryTargets.cmake")
if(NOT DEFINED UNIMEMORY_AGGRESSIVE_INLINING)
    set(UNIMEMORY_AGGRESSIVE_INLINING "@UNIMEMORY_AGGRESSIVE_INLINING@")
endif()
# This is a consumer optimization preference, not an immutable ABI profile.
# The exported expression reads the property, so OFF actually removes /Ob3.
set_property(TARGET UniMemory::UniMemory PROPERTY
    UNIMEMORY_AGGRESSIVE_INLINING "${UNIMEMORY_AGGRESSIVE_INLINING}")
check_required_components(UniMemory)
